<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mycar">
  <xacro:arg name="serial_port" default="/dev/ttyUSB0"/>
  <xacro:arg name="baud_rate" default="115200"/>
  <xacro:arg name="max_rpm" default="100.0"/>

  <xacro:property name="wheel_radius" value="0.0325"/>
  <xacro:property name="wheel_width" value="0.025"/>
  <xacro:property name="wheel_separation" value="0.125"/>

  <material name="body_gray"><color rgba="0.2 0.25 0.28 1"/></material>
  <material name="wheel_black"><color rgba="0.03 0.03 0.03 1"/></material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.07"/>
      <geometry><box size="0.25 0.15 0.10"/></geometry>
      <material name="body_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.07"/>
      <geometry><box size="0.25 0.15 0.10"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.07"/>
      <mass value="2.0"/>
      <inertia ixx="0.0054" ixy="0" ixz="0" iyy="0.0121" iyz="0" izz="0.0133"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="side y sign">
    <link name="${side}_wheel_link">
      <visual>
        <origin rpy="1.570796 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin rpy="1.570796 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.10"/>
        <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00003"/>
      </inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${y} ${wheel_radius}"/>
      <axis xyz="0 ${sign} 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel side="left" y="${wheel_separation / 2.0}" sign="1"/>
  <xacro:wheel side="right" y="${-wheel_separation / 2.0}" sign="1"/>

  <link name="laser">
    <visual>
      <geometry><cylinder radius="0.05" length="0.07"/></geometry>
      <material name="body_gray"/>
    </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0 0 0.2"/>
  </joint>

  <!-- IMU的安装位置和姿态需按实车修改，坐标轴：x右、y后、z下。 -->
  <link name="imu_tracking"/>
  <joint name="imu_tracking_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_tracking"/>
    <origin xyz="0 0 0"/>
  </joint>
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="imu_tracking"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="3.1415926536 0 -1.5707963268"/>
  </joint>

  <!-- 相机相对base_link：前5cm、居中、上2cm，镜头水平朝前。 -->
  <!-- camera_link使用x前y左z上；光学坐标转换由相机SDK提供。 -->
  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.05 0 0.02" rpy="0 0 0"/>
  </joint>

  <ros2_control name="MyCarSystem" type="system">
    <hardware>
      <plugin>mycar_base/MyCarSystem</plugin>
      <param name="serial_port">$(arg serial_port)</param>
      <param name="baud_rate">$(arg baud_rate)</param>
      <!-- RPM控速在STM32完成，真实编码器计数回传ROS计算里程计。 -->
      <param name="max_rpm">$(arg max_rpm)</param>
      <param name="encoder_cpr">1468.2</param>
      <param name="feedback_timeout_ms">500</param>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
