<?xml version="1.0"?>
<package format="3">
  <name>mycar_rtabmap</name>
  <version>0.1.0</version>
  <description>RGB-D and N10 lidar mapping and visual relocalization with external wheel/IMU odometry.</description>
  <maintainer email="yiheng@example.com">yiheng</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>mycar_base</exec_depend>
  <exec_depend>mycar_navigation2</exec_depend>
  <exec_depend>orbbec_camera</exec_depend>
  <exec_depend>rtabmap_slam</exec_depend>
  <exec_depend>rtabmap_sync</exec_depend>
  <exec_depend>rtabmap_util</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_rviz_plugins</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
